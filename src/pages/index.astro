---
import "../styles/global.css";

const email = "krzysztof.piotr.kielek@gmail.com";
const github = "https://www.github.com/keteik";
const linkedin = "https://www.linkedin.com/in/krzysztof-kielek/";
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <title>Krzysztof Kiełek, software engineer</title>
    <meta
      name="description"
      content="Krzysztof Kiełek builds web applications and backend services in TypeScript."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Krzysztof Kiełek, software engineer" />
    <meta
      property="og:description"
      content="Web applications and backend services in TypeScript."
    />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <main class="page">
      <h1>Krzysztof Kiełek</h1>

      <p>
        I'm a software engineer. The things I keep coming back to are how
        software is built, how it gets broken into, and how the networks
        underneath it all actually work.
      </p>
      <p>
        I got here through an IT engineering degree and a year of fixing
        other people's computers, which is still a good way to learn how
        things break.
      </p>
      <p>
        If you want to talk, email works best. My code is on GitHub, and the
        CV is on LinkedIn.
      </p>

      <p class="contact">
        <a href={`mailto:${email}`}>{email}</a>
        <span aria-hidden="true">/</span>
        <a href={github} rel="noopener noreferrer">GitHub</a>
        <span aria-hidden="true">/</span>
        <a href={linkedin} rel="noopener noreferrer">LinkedIn</a>
      </p>

      <footer class="meta">© {year}</footer>
    </main>
  </body>
</html>
